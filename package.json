{
  "name": "the-system",
  "private": true,
  "version": "9.2.0",
  "packageManager": "pnpm@10.12.4",
  "type": "module",
  "scripts": {
    "dev": "vite --configLoader runner",
    "build": "tsc -b && vite build --configLoader runner",
    "build:sites": "pnpm run build && node scripts/build-sites.mjs",
    "preview": "vite preview",
    "test": "vitest run --configLoader runner",
    "test:watch": "vitest --configLoader runner",
    "test:simulator": "vitest run src/tests/simulator.test.ts --reporter=verbose --configLoader runner",
    "lint": "eslint .",
    "format": "prettier --write .",
    "icons": "node scripts/generate-icons.mjs"
  },
  "dependencies": {
    "dexie": "^4.0.11",
    "lucide-react": "^0.468.0",
    "mammoth": "1.12.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "workbox-window": "^7.3.0",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.16",
    "fake-indexeddb": "^6.0.0",
    "jsdom": "^26.1.0",
    "prettier": "^3.4.2",
    "typescript": "~5.6.2",
    "typescript-eslint": "^8.18.2",
    "vite": "^6.0.5",
    "vite-plugin-pwa": "^1.0.3",
    "vitest": "^3.2.4"
  }
}
